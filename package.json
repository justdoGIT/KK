{
  "name": "embedded-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Embedded Systems Portfolio & Technical Consultancy Website",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
